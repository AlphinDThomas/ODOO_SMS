PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Privileged Prisma connection (server only).
# Use Supabase PgBouncer Transaction Mode (Port 6543) with ?pgbouncer=true to avoid EMAXCONNSESSION (max clients 15 limit)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase project URL (safe to mirror to the frontend as VITE_SUPABASE_URL)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Publishable (anon) key — used by Auth getUser() and the frontend. Not a JWT HMAC secret.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret/service key — server only. Admin Auth API (create staff). Never put this in Vite env.
SUPABASE_SECRET_KEY="sb_secret_..."
