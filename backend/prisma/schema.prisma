generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Application tables only. Do not map or migrate Supabase Auth (auth.users).
// Prisma uses DATABASE_URL as a privileged connection. Row Level Security is
// not relied on: every query must be authorized in the service layer.

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  ADDON
  OTHER
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  EXPIRED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  UPI
  OTHER
}

enum BillingAttemptStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model UserProfile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer             Customer?
  createdSubscriptions Subscription[] @relation("SubscriptionCreatedBy")
  acceptedQuotations   Subscription[] @relation("SubscriptionAcceptedBy")
  recordedPayments     Payment[]

  @@index([role])
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @unique @db.Uuid
  user         UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyName  String
  billingEmail String
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([billingEmail])
}

model Product {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  type       ProductType
  salesPrice Decimal     @db.Decimal(12, 2)
  costPrice  Decimal     @db.Decimal(12, 2)
  notes      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  variants            ProductVariant[]
  taxRules            ProductTaxRule[]
  discountProducts    DiscountProduct[]
  templateLines       QuotationTemplateLine[]
  subscriptionLines   SubscriptionLine[]
  invoiceLines        InvoiceLine[]
}

model ProductVariant {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @db.Uuid
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  priceAdjustment  Decimal  @db.Decimal(12, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]

  @@unique([productId, name])
}

model TaxRule {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  ratePercent Decimal @db.Decimal(7, 4)
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products ProductTaxRule[]
}

model ProductTaxRule {
  productId String   @db.Uuid
  taxRuleId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxRule   TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  @@id([productId, taxRuleId])
}

model Plan {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  amount          Decimal         @db.Decimal(12, 2)
  interval        BillingInterval
  minQuantity     Int             @default(1)
  availableFrom   DateTime        @db.Date
  availableTo     DateTime?       @db.Date
  autoCloseOnEnd  Boolean         @default(true)
  allowEarlyClose Boolean         @default(false)
  allowPause      Boolean         @default(false)
  allowRenewal    Boolean         @default(true)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  templates     QuotationTemplate[]
  subscriptions Subscription[]
}

model QuotationTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  planId       String   @db.Uuid
  plan         Plan     @relation(fields: [planId], references: [id])
  validityDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
}

model QuotationTemplateLine {
  id         String            @id @default(uuid()) @db.Uuid
  templateId String            @db.Uuid
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String            @db.Uuid
  product    Product           @relation(fields: [productId], references: [id])
  variantId  String?           @db.Uuid
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPrice  Decimal           @db.Decimal(12, 2)
  sortOrder  Int               @default(0)
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  number               String             @unique
  customerId           String             @db.Uuid
  customer             Customer           @relation(fields: [customerId], references: [id])
  planId               String             @db.Uuid
  plan                 Plan               @relation(fields: [planId], references: [id])
  templateId           String?            @db.Uuid
  template             QuotationTemplate? @relation(fields: [templateId], references: [id])
  status               SubscriptionStatus @default(DRAFT)
  startDate            DateTime           @db.Date
  expiryDate           DateTime           @db.Date
  paymentTermsDays     Int                @default(15)
  billingInterval      BillingInterval
  nextBillingDate      DateTime?          @db.Date
  quotationValidityDays Int
  quotationExpiresAt   DateTime?
  submittedAt          DateTime?
  acceptedAt           DateTime?
  acceptedById         String?            @db.Uuid
  acceptedBy           UserProfile?       @relation("SubscriptionAcceptedBy", fields: [acceptedById], references: [id])
  createdById          String             @db.Uuid
  createdBy            UserProfile        @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])
  pausedAt             DateTime?
  closedAt             DateTime?
  closeReason          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  lines       SubscriptionLine[]
  discounts   SubscriptionDiscount[]
  invoices    Invoice[]
  billingRecords BillingRecord[]

  @@index([status, nextBillingDate])
  @@index([customerId, status])
  @@index([status, quotationExpiresAt])
}

model SubscriptionLine {
  id             String          @id @default(uuid()) @db.Uuid
  subscriptionId String          @db.Uuid
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRatePercent Decimal         @db.Decimal(7, 4) @default(0)
  lineAmount     Decimal         @db.Decimal(12, 2)
  sortOrder      Int             @default(0)
}

model DiscountRule {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  type              DiscountType
  value             Decimal       @db.Decimal(12, 4)
  minPurchaseAmount Decimal?      @db.Decimal(12, 2)
  minQuantity       Int?
  validFrom         DateTime      @db.Date
  validTo           DateTime?     @db.Date
  maxUses           Int?
  usesCount         Int           @default(0)
  scope             DiscountScope
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  products      DiscountProduct[]
  subscriptions SubscriptionDiscount[]

  @@index([isActive, validFrom, validTo])
}

model DiscountProduct {
  discountId String       @db.Uuid
  productId  String       @db.Uuid
  discount   DiscountRule @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}

model SubscriptionDiscount {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  discountId     String       @db.Uuid
  discount       DiscountRule @relation(fields: [discountId], references: [id])
  isActive       Boolean      @default(true)
  timesApplied   Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, discountId])
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  number           String        @unique
  subscriptionId   String        @db.Uuid
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId       String        @db.Uuid
  customer         Customer      @relation(fields: [customerId], references: [id])
  status           InvoiceStatus @default(DRAFT)
  periodStart      DateTime      @db.Date
  periodEnd        DateTime      @db.Date
  issueDate        DateTime      @db.Date
  dueDate          DateTime      @db.Date
  subtotal         Decimal       @db.Decimal(12, 2)
  discountTotal    Decimal       @db.Decimal(12, 2) @default(0)
  taxTotal         Decimal       @db.Decimal(12, 2) @default(0)
  grandTotal       Decimal       @db.Decimal(12, 2)
  amountPaid       Decimal       @db.Decimal(12, 2) @default(0)
  balanceDue       Decimal       @db.Decimal(12, 2)
  customerSnapshot Json
  sentAt           DateTime?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lines         InvoiceLine[]
  payments      Payment[]
  billingRecord BillingRecord?

  @@index([customerId, status, dueDate])
  @@index([status, dueDate])
  @@index([subscriptionId, periodStart])
}

model InvoiceLine {
  id             String          @id @default(uuid()) @db.Uuid
  invoiceId      String          @db.Uuid
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?         @db.Uuid
  product        Product?        @relation(fields: [productId], references: [id])
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  description    String
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRatePercent Decimal         @db.Decimal(7, 4) @default(0)
  taxAmount      Decimal         @db.Decimal(12, 2) @default(0)
  discountAmount Decimal         @db.Decimal(12, 2) @default(0)
  lineTotal      Decimal         @db.Decimal(12, 2)
  sortOrder      Int             @default(0)
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime
  note         String?
  recordedById String        @db.Uuid
  recordedBy   UserProfile   @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model BillingRecord {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  invoiceId      String?   @unique @db.Uuid
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id])
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())

  attempts BillingAttempt[]

  @@unique([subscriptionId, periodStart])
}

model BillingAttempt {
  id              String               @id @default(uuid()) @db.Uuid
  billingRecordId String?              @db.Uuid
  billingRecord   BillingRecord?       @relation(fields: [billingRecordId], references: [id])
  subscriptionId  String               @db.Uuid
  periodStart     DateTime             @db.Date
  status          BillingAttemptStatus
  errorMessage    String?
  attemptedAt     DateTime             @default(now())

  @@index([subscriptionId, periodStart])
}

model Sequence {
  name  String @id
  value Int    @default(0)
}
